common --registry=https://raw.githubusercontent.com/digiboys/bazel-registry/main
common --registry=https://bcr.bazel.build

common --repo_env="BAZEL_USE_CPP_ONLY_TOOLCHAIN=1"
common:macos --xcode_version_config=//tools:host_xcodes
# skip Xcode autoconfiguration for the C++ toolchain `apple_support` registers
common:macos --repo_env="BAZEL_NO_APPLE_CPP_TOOLCHAIN=1"

# tools/bazel sets PATH and LD_LIBRARY_PATH to Nix tools and libraries. Pass them
# to actions and tests explicitly instead of relying on the default of
# --incompatible_strict_action_env.
common --incompatible_strict_action_env=false
common --action_env=PATH
common --action_env=LD_LIBRARY_PATH
common --host_action_env=PATH
common --host_action_env=LD_LIBRARY_PATH
common --test_env=PATH

common --action_env="BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1"
common --announce_rc
common --color=yes
common --curses=yes
common --ui_actions_shown=20
common --progress_in_terminal_title
common --enable_platform_specific_config
common --lockfile_mode=error

import %workspace%/tools/remote-cache.bazelrc

common --@rules_python//python/config_settings:bootstrap_impl=script
common --experimental_repository_cache_hardlinks

common --incompatible_config_setting_private_default_visibility

build --@bazel_clang_format//:binary=@llvm_toolchain//:clang-format
build --@bazel_clang_format//:config=//:format-config

build --@rules_clang_tidy//:clang-tidy=@llvm_toolchain//:clang-tidy
build --@rules_clang_tidy//:config=//:tidy-config

test --test_output=errors
test --test_summary=detailed
test --test_verbose_timeout_warnings

try-import %workspace%/.nixos-autoconfig/bazelrc
try-import %workspace%/user.bazelrc
