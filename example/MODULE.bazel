module(name = "cortex_m_examples")

bazel_dep(name = "cortex_m", dev_dependency = True)
local_path_override(
    module_name = "cortex_m",
    path = "..",
)

bazel_dep(
    name = "rules_cc",
    version = "0.1.3",
    dev_dependency = True,
)

# TODO toolchains_arm_gnu should be pulled in as a dependency after changes have
# been merged upstream
bazel_dep(
    name = "toolchains_arm_gnu",
    dev_dependency = True,
)

TOOLCHAINS_ARM_GNU_COMMIT = "6895733b87d3a75a40056b12c3d6628bc6945011"

archive_override(
    module_name = "toolchains_arm_gnu",
    integrity = "sha256-QKl/PAnjE4O4IEKIwImJIT3ihjtWHPTY9h5FBg7yKFQ=",
    patch_cmds = [
        # Bazel 9 removes @local_config_platform
        "sed -i.bak 's|@local_config_platform//:constraints.bzl|@platforms//host:constraints.bzl|' toolchain/templates/toolchain.bazel",
        "rm toolchain/templates/toolchain.bazel.bak",
    ],
    strip_prefix = "toolchains_arm_gnu-{commit}".format(
        commit = TOOLCHAINS_ARM_GNU_COMMIT,
    ),
    urls = [
        "https://github.com/hexdae/toolchains_arm_gnu/archive/{commit}.tar.gz".format(
            commit = TOOLCHAINS_ARM_GNU_COMMIT,
        ),
    ],
)
