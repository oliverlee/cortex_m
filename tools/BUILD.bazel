load("@apple_support//xcode:xcode_config.bzl", "detected_xcodes", "xcode_config")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@local_workspace_directories//:defs.bzl", "BAZEL_WORKSPACE_ROOT")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@rules_multirun//:defs.bzl", "command", "multirun")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# The default `detected_versions` is `@local_config_xcode`, which runs `xcrun`
# for each installed Xcode.
detected_xcodes(name = "no_detected_xcodes")

xcode_config(
    name = "host_xcodes",
    detected_versions = ":no_detected_xcodes",
)

buildifier(
    name = "buildifier.check",
    lint_mode = "warn",
    mode = "check",
    tags = ["manual"],
)

buildifier(
    name = "buildifier",
    lint_mode = "warn",
    mode = "fix",
    tags = ["manual"],
)

command(
    name = "nixfmt.check",
    args = [
        "--ci",
        "--tree-root",
        BAZEL_WORKSPACE_ROOT,
        "--working-dir",
        BAZEL_WORKSPACE_ROOT,
    ],
    command = "@nixfmt-tree",
    tags = ["manual"],
)

command(
    name = "nixfmt",
    args = [
        "--tree-root",
        BAZEL_WORKSPACE_ROOT,
        "--working-dir",
        BAZEL_WORKSPACE_ROOT,
    ],
    command = "@nixfmt-tree",
    tags = ["manual"],
)

genrule(
    name = "gen-clang-format",
    outs = ["clang-format.bash"],
    cmd = """
echo "#!/usr/bin/env bash" > $@
echo "cd \\$$BUILD_WORKSPACE_DIRECTORY" >> $@
echo "exec bazelisk build \\$$@ //..." >> $@
""",
    tags = ["manual"],
)

sh_binary(
    name = "clang-format.check",
    srcs = ["clang-format.bash"],
    args = [
        "--aspects=@bazel_clang_format//:defs.bzl%check_aspect",
        "--output_groups=report",
        "--keep_going",
    ],
    tags = ["manual"],
)

sh_binary(
    name = "clang-format",
    srcs = ["clang-format.bash"],
    args = [
        "--aspects=@bazel_clang_format//:defs.bzl%fix_aspect",
        "--output_groups=report",
        "--keep_going",
        "--use_action_cache=false",
    ],
    tags = ["manual"],
)

multirun(
    name = "format.check",
    commands = [
        ":buildifier.check",
        ":clang-format.check",
        ":nixfmt.check",
    ],
    tags = ["manual"],
)

multirun(
    name = "format",
    commands = [
        ":buildifier",
        ":clang-format",
        ":nixfmt",
    ],
    tags = ["manual"],
)

genrule(
    name = "gen-clang-tidy",
    outs = ["clang-tidy.bash"],
    cmd = """
echo "#!/usr/bin/env bash" > $@
echo "cd \\$$BUILD_WORKSPACE_DIRECTORY" >> $@
echo "exec bazelisk build {options} \\$${{@:-//...}}" >> $@
""".format(
        options = " ".join([
            "--aspects=@rules_clang_tidy//:aspects.bzl%check",
            "--output_groups=report",
            "--keep_going",
            "--verbose_failures",
        ]),
    ),
    tags = ["manual"],
)

# lint all targets with default options
#  bazel run //tools:lint
#
# lint with a single check on a single target
#   bazel run //tools:lint -- \
#     --@rules_clang_tidy//:extra-options=--checks='-*,clang-analyzer-core.uninitialized.Assign' \
#     //test:point_test
#
sh_binary(
    name = "clang-tidy",
    srcs = ["clang-tidy.bash"],
    tags = ["manual"],
)

alias(
    name = "lint",
    actual = ":clang-tidy",
    tags = ["manual"],
)

refresh_compile_commands(
    name = "compile_commands",
    tags = ["manual"],
    target_compatible_with = HOST_CONSTRAINTS,
    targets = {
        "//...": "--extra_toolchains=@llvm_toolchain//:all",
    },
)
